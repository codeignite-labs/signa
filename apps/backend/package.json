{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"!src/database/migrations/**/*\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "db:migration:create": "typeorm-ts-node-commonjs migration:create",
    "db:migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate",
    "db:migration:check": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate src/database/migrations/AutoMigration --check",
    "db:migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "db:migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@bull-board/api": "^8.0.1",
    "@bull-board/express": "^8.0.1",
    "@bull-board/nestjs": "^8.0.1",
    "@casl/ability": "^7.0.0",
    "@embedpdf/pdfium": "^2.14.4",
    "@keyv/redis": "^5.1.6",
    "@napi-rs/canvas": "^1.0.2",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.2",
    "@repo/shared": "workspace:*",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "3.3.0",
    "asn1js": "^3.0.10",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.79.0",
    "cache-manager": "^7.2.8",
    "cacheable": "^2.3.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-basic-auth": "^1.2.1",
    "fflate": "^0.8.3",
    "file-type": "^22.0.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "keyv": "^5.6.0",
    "libphonenumber-js": "^1.13.6",
    "libreoffice-convert": "^1.8.1",
    "morgan": "^1.11.0",
    "nestjs-i18n": "^10.8.4",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.21.0",
    "pkijs": "^3.4.0",
    "playwright": "^1.61.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.1",
    "twilio": "^6.0.2",
    "typeorm": "^1.0.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/ts-config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^otplib$": "<rootDir>/test/otplib.mock.ts",
      "^uuid$": "<rootDir>/test/uuid.mock.ts",
      "^@repo/shared/branding$": "<rootDir>/../../../packages/shared/src/branding.ts",
      "^@repo/shared$": "<rootDir>/test/shared-package.mock.ts"
    }
  }
}
