<!doctype html>
<html lang="{{locale}}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <title>{{subject}}</title>
    <style>
      @media only screen and (max-width: 640px) {
        .container { width: 100% !important; }
        .content { padding: 28px 20px !important; }
        .title { font-size: 30px !important; line-height: 36px !important; }
      }
    </style>
  </head>
  <body style="margin:0; padding:0; background:{{brandBackground}}; color:{{brandForeground}}; font-family:Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:{{brandBackground}};">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" class="container" width="640" cellspacing="0" cellpadding="0" border="0" style="width:640px; max-width:640px; background:#ffffff; border-radius:22px; box-shadow:0 18px 42px rgba(23,52,87,0.14); overflow:hidden;">
            <tr>
              <td align="center" style="padding:34px 24px 8px;">
                {{#if logoUrl}}<table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr><td style="vertical-align:middle;"><img src="{{logoUrl}}" width="64" alt="{{#unless showBusinessName}}{{productName}}{{/unless}}" style="display:block; width:64px; max-width:64px; max-height:64px; object-fit:contain; height:auto; border:0;"></td>{{#if showBusinessName}}<td style="vertical-align:middle; padding-left:16px; color:{{brandForeground}}; font-size:20px; font-weight:700;">{{productName}}</td>{{/if}}</tr></table>{{else}}<strong style="font-size:24px; color:{{brandForeground}};">{{productName}}</strong>{{/if}}
              </td>
            </tr>
            <tr>
              <td class="content" style="padding:20px 40px 42px;">
                <h1 class="title" style="margin:0 0 22px; color:{{brandForeground}}; font-size:38px; line-height:46px; font-weight:800;">Document declined</h1>
                <p style="margin:0 0 14px; color:{{brandMutedForeground}}; font-size:18px; line-height:30px;">Hi there,</p>
                <p style="margin:0 0 22px; color:{{brandMutedForeground}}; font-size:18px; line-height:30px;">"{{templateName}}" has been declined by {{submitterName}}.</p>
                {{#if declineReason}}
                  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0;">
                    <tr>
                      <td style="background:#fff2f2; border:1px solid #ffd3d3; border-radius:16px; padding:18px 20px; color:#8a2020; font-size:16px; line-height:26px;">{{declineReason}}</td>
                    </tr>
                  </table>
                {{/if}}
                <p style="margin:24px 0 0; color:{{brandMutedForeground}}; font-size:17px; line-height:28px;"><a href="{{submissionUrl}}" style="color:{{brandForeground}}; font-weight:700;">Open submission</a></p>
              </td>
            </tr>
          </table>
          {{#unless whiteLabel}}<p style="margin:22px 0 0; color:{{brandMutedForeground}}; font-size:13px; line-height:20px;">Sent securely with Signa</p>{{/unless}}
        </td>
      </tr>
    </table>
  </body>
</html>
