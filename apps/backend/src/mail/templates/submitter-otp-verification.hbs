<!doctype html>
<html lang="{{locale}}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <title>Email verification</title>
  </head>
  <body style="margin:0; padding:0; background:{{brandBackground}}; color:{{brandForeground}}; font-family:Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:{{brandBackground}};">
      <tr>
        <td align="center" style="padding:32px 12px;">
          <table role="presentation" width="560" cellspacing="0" cellpadding="0" border="0" style="width:560px; max-width:100%; background:#ffffff; border-radius:22px; box-shadow:0 18px 42px rgba(23,52,87,0.14);">
            <tr>
              <td align="center" style="padding:34px 24px 8px;">
                {{#if logoUrl}}<table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr><td style="vertical-align:middle;"><img src="{{logoUrl}}" width="64" alt="{{#unless showBusinessName}}{{productName}}{{/unless}}" style="display:block; width:64px; max-width:64px; max-height:64px; object-fit:contain; height:auto; border:0;"></td>{{#if showBusinessName}}<td style="vertical-align:middle; padding-left:16px; color:{{brandForeground}}; font-size:20px; font-weight:700;">{{productName}}</td>{{/if}}</tr></table>{{else}}<strong style="font-size:24px; color:{{brandForeground}};">{{productName}}</strong>{{/if}}
              </td>
            </tr>
            <tr>
              <td style="padding:22px 34px 38px;">
                <h1 style="margin:0 0 18px; color:{{brandForeground}}; font-size:32px; line-height:38px; font-weight:800;">Verify your email</h1>
                <p style="margin:0 0 20px; color:{{brandMutedForeground}}; font-size:17px; line-height:28px;">Use this verification code to access "{{templateName}}".</p>
                <p style="margin:0 0 24px; padding:18px 20px; background:{{brandMuted}}; border:1px solid {{brandBorder}}; border-radius:16px; color:{{brandForeground}}; font-size:34px; line-height:42px; font-weight:800; text-align:center; letter-spacing:6px;">{{otpCode}}</p>
                <p style="margin:0; color:{{brandMutedForeground}}; font-size:14px; line-height:22px;">Please reply to this email if you did not request this.</p>
              </td>
            </tr>
          </table>
          {{#unless whiteLabel}}<p style="margin:22px 0 0; color:{{brandMutedForeground}}; font-size:13px; line-height:20px;">Sent securely with Signa</p>{{/unless}}
        </td>
      </tr>
    </table>
  </body>
</html>
