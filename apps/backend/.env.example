# Server
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api

# Web-app auth
# Production requires at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-development-secret
JWT_EXPIRES_IN=7d
# Mirrors DocuSeal on-prem defaults:
# - initial_only: first user can self-register, then registration closes
# - open: public signup
# - disabled: no self-service registration
REGISTRATION_MODE=initial_only

# Database
# Mirrors DocuSeal deployment behavior:
# - leave DATABASE_URL empty for file-backed SQLite
# - set one PostgreSQL DATABASE_URL to switch engines
DATABASE_TYPE=
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=signa_development
# Encrypts PostgreSQL traffic without requiring a custom CA certificate.
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_MIGRATIONS_RUN=false
SQLITE_DATABASE_PATH=data/signa.sqlite
SQLITE_SYNCHRONIZE=true

# Cache
# Leave empty for local in-memory cache. Use redis://localhost:6379 when Redis is available.
REDIS_URL=
CACHE_NAMESPACE=signa-cache
CACHE_TTL_MS=3600000

# Background jobs
# Redis is required when QUEUE_ENABLED=true.
QUEUE_ENABLED=false
QUEUE_REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=signa
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000

# Queue dashboard
# Enable only for trusted environments and always change the password.
BULL_BOARD_ENABLED=false
BULL_BOARD_ROUTE=/queues
BULL_BOARD_USER=admin
BULL_BOARD_PASS=change-me-please

# Mail
# Preferred self-hosted contract. SMTP_ADDRESS enables delivery automatically.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_ENABLE_STARTTLS=true
SMTP_ENABLE_SSL=false
SMTP_ENABLE_TLS=false
SMTP_SSL_VERIFY=true
SMTP_OPEN_TIMEOUT=15
SMTP_READ_TIMEOUT=25

# Legacy Signa aliases. Existing deployments may continue using these.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_AUTH_ENABLED=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=Signa
MAIL_FROM_ADDRESS=no-reply@signa.com
MAIL_REPLY_TO=
MAIL_TEMPLATE_DIR=
MAIL_LOGO_URL=http://localhost:3000/images/logo.png
MAIL_ASSET_BASE_URL=http://localhost:3000/images/email
MAIL_CALLBACK_SECRET=
MAIL_TLS_REJECT_UNAUTHORIZED=true

# Social login
# Register these as Web redirect URIs with each provider.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/auth/oauth/google/callback

# Email account integrations
# Redirect URIs should point to the frontend OAuth callback page when wired.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/settings/integrations/gmail/callback

# Webhook delivery
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_MS=30000

# Health checks
STORAGE_SERVICE=auto
STORAGE_PATH=storage
S3_ATTACHMENTS_BUCKET=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_ENDPOINT=
AWS_S3_BUCKET=
AWS_S3_PREFIX=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_SERVER_SIDE_ENCRYPTION=
ATTACHMENT_INGEST_MAX_BYTES=10485760
PDF_PREVIEW_MAX_PAGES=15
PDF_PREVIEW_MAX_WIDTH=1400
# Generate once with openssl rand -hex 32; keep in your secret manager and back it up.
SIGNING_KEY_ENCRYPTION_KEY=
# Approved TSA root/intermediate PEM certificates (literal \n separators supported).
PDF_TSA_TRUST_CERTIFICATES=
# Require the signing chain to terminate at an uploaded account trust anchor.
# Development override. Set all three signing policy flags to true in production.
PDF_REQUIRE_TRUSTED_SIGNER=false
PDF_SIGNATURE_SUBFILTER=pades
# Optional fail-closed mode for deployments that require RFC3161 timestamps.
PDF_TIMESTAMP_REQUIRED=false
PDF_TIMESTAMP_TIMEOUT_MS=10000
# Optional fail-closed mode for deployments that require DSS/VRI revocation evidence.
PDF_LTV_REQUIRED=false
PDF_LTV_HTTP_TIMEOUT_MS=10000
DOCUMENT_CONVERSION_MAX_BYTES=15728640
HTML_TO_PDF_TIMEOUT_MS=30000
HEALTH_HEAP_LIMIT_MB=512
HEALTH_REDIS_REQUIRED=false
HEALTH_REDIS_TIMEOUT_MS=1000
API_HEALTH_WINDOW_MS=300000
API_SLOW_REQUEST_WARN_MS=1000
API_HEALTH_P95_DEGRADED_MS=1000
API_HEALTH_ERROR_RATE_DEGRADED_PERCENT=5
API_HEALTH_MIN_REQUEST_COUNT=20

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Phone verification
# Uses Twilio Verify when configured. Leave empty to disable phone OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# SMS invitations
# Uses Twilio Messaging when configured. Prefer a Messaging Service SID; use a From phone as a fallback.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_PHONE=
SMS_CALLBACK_SECRET=
