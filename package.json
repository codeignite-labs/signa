{
  "name": "signa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:marketing": "pnpm --filter marketing dev",
    "start:backend": "pnpm --filter backend start",
    "start:frontend": "pnpm --filter frontend start",
    "start:marketing": "pnpm --filter marketing start",
    "start:backend:prod": "pnpm --filter backend start:prod",
    "build": "turbo run build",
    "build:deploy": "NEXT_PUBLIC_API_BASE_URL= pnpm build",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:marketing": "pnpm --filter marketing build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:backend": "pnpm --filter backend test",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:packages": "pnpm build && changeset publish",
    "pack:signa-react": "pnpm --filter @signajs/react pack --dry-run",
    "pack:signa-react-native": "pnpm --filter @signajs/react-native pack --dry-run",
    "typeorm": "pnpm --filter backend typeorm",
    "db:migration:create": "pnpm --filter backend db:migration:create src/database/migrations/ManualMigration",
    "db:migration:generate": "pnpm --filter backend db:migration:generate src/database/migrations/AutoMigration",
    "db:migration:check": "pnpm --filter backend db:migration:check",
    "db:migration:run": "pnpm --filter backend db:migration:run",
    "db:migration:revert": "pnpm --filter backend db:migration:revert",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9"
  },
  "license": "AGPL-3.0-only"
}
