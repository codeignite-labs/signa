# Root example for running through the monorepo. Package-local examples live in:
# - apps/backend/.env.example
# - apps/frontend/.env.example
# - apps/marketing/.env.example

# Backend
NODE_ENV=development
PORT=3001
# One public URL is enough in Docker. FRONTEND_ORIGIN and API_PUBLIC_URL are
# derived from APP_URL by the container entrypoint.
APP_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api
APP_VERSION=0.1.0
APP_COMMIT_SHA=
APP_BUILD_TIME=
JWT_SECRET=change-me-to-a-long-random-development-secret
JWT_EXPIRES_IN=7d
# Mirrors DocuSeal on-prem defaults:
# - initial_only: first user can self-register, then registration closes
# - open: public signup
# - disabled: no self-service registration
REGISTRATION_MODE=initial_only

# Leave DATABASE_URL empty for SQLite. Set a PostgreSQL URL to switch engines.
DATABASE_TYPE=
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=signa
# Encrypts PostgreSQL traffic without requiring a custom CA certificate.
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_MIGRATIONS_RUN=false
SQLITE_DATABASE_PATH=data/signa.sqlite
SQLITE_SYNCHRONIZE=true

REDIS_URL=
CACHE_NAMESPACE=signa-cache
CACHE_TTL_MS=3600000

# Background jobs
# Docker starts a private Redis process when REDIS_URL is empty.
QUEUE_ENABLED=true
QUEUE_REDIS_URL=
QUEUE_PREFIX=signa
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000

# Email
# SMTP_ADDRESS enables delivery; no separate enable/auth switches are needed.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_ENABLE_STARTTLS=true
SMTP_ENABLE_SSL=false
SMTP_SSL_VERIFY=true
SMTP_OPEN_TIMEOUT=15
SMTP_READ_TIMEOUT=25

# Storage
# Set only S3_ATTACHMENTS_BUCKET to enable S3. Region defaults to us-east-1,
# and the AWS SDK automatically uses IAM roles or your standard AWS profile.
STORAGE_SERVICE=auto
STORAGE_PATH=apps/backend/storage
S3_ATTACHMENTS_BUCKET=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional S3-compatible endpoint. Its presence enables path-style requests.
S3_ENDPOINT=
# Backward-compatible and advanced options.
AWS_S3_BUCKET=
AWS_S3_PREFIX=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_SERVER_SIDE_ENCRYPTION=
ATTACHMENT_INGEST_MAX_BYTES=10485760
PDF_PREVIEW_MAX_PAGES=15
PDF_PREVIEW_MAX_WIDTH=1400
# Generate once with openssl rand -hex 32; keep in your secret manager and back it up.
SIGNING_KEY_ENCRYPTION_KEY=
# Approved TSA root/intermediate PEM certificates (literal \n separators supported).
PDF_TSA_TRUST_CERTIFICATES=
# Require the signing chain to terminate at an uploaded account trust anchor.
# Development override. Set all three signing policy flags to true in production.
PDF_REQUIRE_TRUSTED_SIGNER=false
PDF_SIGNATURE_SUBFILTER=pades
# Optional fail-closed mode for deployments that require RFC3161 timestamps.
PDF_TIMESTAMP_REQUIRED=false
PDF_TIMESTAMP_TIMEOUT_MS=10000
# Optional fail-closed mode for deployments that require DSS/VRI revocation evidence.
PDF_LTV_REQUIRED=false
PDF_LTV_HTTP_TIMEOUT_MS=10000
DOCUMENT_CONVERSION_MAX_BYTES=15728640
HTML_TO_PDF_TIMEOUT_MS=30000
HEALTH_HEAP_LIMIT_MB=512
HEALTH_REDIS_REQUIRED=false
HEALTH_REDIS_TIMEOUT_MS=1000
API_HEALTH_WINDOW_MS=300000
API_SLOW_REQUEST_WARN_MS=1000
API_HEALTH_P95_DEGRADED_MS=1000
API_HEALTH_ERROR_RATE_DEGRADED_PERCENT=5
API_HEALTH_MIN_REQUEST_COUNT=20

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Phone verification
# Uses Twilio Verify when configured. Leave empty to disable phone OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_PHONE=

# Social login
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/auth/oauth/google/callback

# Email account integrations
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/settings/integrations/gmail/callback

# Frontend
# Empty uses same-origin /api, which is the recommended deployment mode.
NEXT_PUBLIC_API_BASE_URL=
# Standalone marketing, documentation, and journal origin.
# Production: https://signa-docs.vercel.app
NEXT_PUBLIC_MARKETING_URL=http://localhost:3002
# Optional. Use your LAN URL in development so QR signing opens on a phone.
# Example: http://192.168.1.20:3000
NEXT_PUBLIC_SIGNING_BASE_URL=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=
NEXT_OUTPUT=

# Marketing
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=
# Server-only key used by marketing Route Handlers. Never prefix with
# NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=
